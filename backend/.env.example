PORT=5001
NODE_ENV=production
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>/<database>
JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes-long
JWT_EXPIRES_IN=7d
CLIENT_URL=https://vir-verse-saga.vercel.app

# Set these only when routing C execution to the separately deployed runner.
EXECUTION_DRIVER=remote
RUNNER_URL=https://runner.your-domain.example
RUNNER_SERVICE_SECRET=replace-with-a-dedicated-random-secret-at-least-32-bytes-long
RUNNER_TICKET_SECRET=replace-with-a-different-random-secret-at-least-32-bytes-long
